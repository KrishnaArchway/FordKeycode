<!-- Use this file to deploy some handlers/chains and services      -->
<!-- Two ways to do this:                                           -->
<!--   java org.apache.axis.client.AdminClient deploy.wsdd          -->
<!--      after the axis server is running                          -->
<!-- or                                                             -->
<!--   java org.apache.axis.utils.Admin client|server deploy.wsdd   -->
<!--      from the same directory that the Axis engine runs         -->

<deployment
    xmlns="http://xml.apache.org/axis/wsdd/"
    xmlns:java="http://xml.apache.org/axis/wsdd/providers/java">

  <!-- Services from VinNewImplService WSDL service -->

  <service name="validateNewVin" provider="java:RPC" style="rpc" use="encoded">
      <parameter name="wsdlTargetNamespace" value="urn:validateNewVin"/>
      <parameter name="wsdlServiceElement" value="VinNewImplService"/>
      <parameter name="schemaUnqualified" value="urn:validateNewVin"/>
      <parameter name="wsdlServicePort" value="validateNewVin"/>
      <parameter name="className" value="com.archway.webservices.newservices.ValidateNewVinSoapBindingImpl"/>
      <parameter name="wsdlPortType" value="VinNewImpl"/>
      <parameter name="typeMappingVersion" value="1.2"/>
      <operation name="validateVinNewVehicle" qname="operNS:validateVinNewVehicle" xmlns:operNS="urn:validateNewVin" returnQName="validateVinNewVehicleReturn" returnType="rtns:VinResponseEntity" xmlns:rtns="urn:validateNewVin" soapAction="" >
        <parameter qname="vinRequestEntity" type="tns:VinRequestEntity" xmlns:tns="urn:validateNewVin"/>
      </operation>
      <parameter name="allowedMethods" value="validateVinNewVehicle"/>
      <parameter name="scope" value="Session"/>

      <typeMapping
        xmlns:ns="urn:validateNewVin"
        qname="ns:VinResponseEntity"
        type="java:com.archway.webservices.newservices.VinResponseEntity"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <typeMapping
        xmlns:ns="urn:validateNewVin"
        qname="ns:VinRequestEntity"
        type="java:com.archway.webservices.newservices.VinRequestEntity"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
  </service>
</deployment>
